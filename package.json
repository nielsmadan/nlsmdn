{
  "name": "nlsmdn",
  "type": "module",
  "version": "5.5.1",
  "scripts": {
    "setup": "bun install --frozen-lockfile && lefthook install && bun run doctor",
    "doctor": "test -d node_modules && lefthook validate && test -x \"$(git rev-parse --git-path hooks/pre-commit)\" && test -x \"$(git rev-parse --git-path hooks/post-checkout)\" && test -x \"$(git rev-parse --git-path hooks/pre-push)\" || { echo 'Setup incomplete; run bun run setup' >&2; exit 1; }",
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "format:check": "biome format src",
    "type-check": "astro check",
    "check-all": "bun run check && bun run type-check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.7",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@emnapi/runtime": "^1.11.3",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "lefthook": "^2.2.2",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3"
  }
}
