---
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ResearchCard from "@/components/ResearchCard.astro";
import ResearchSignup from "@/components/ResearchSignup.astro";
import { getArticle, getResearchArticles } from "@/utils/researchCollections";
import { RESEARCH } from "@/research.config";
import { SITE } from "@/config";

const metas = await getResearchArticles();
const articles = await Promise.all(
  metas.map(async (meta) => ({
    meta,
    hasCurrent: (await getArticle(meta.slug))?.current != null,
  })),
);

const description = "Research notes I keep current.";
---

<Layout
  title={`${RESEARCH.title} | ${SITE.title}`}
  {description}
  extraFeeds={[{ title: `${RESEARCH.title} | ${SITE.title}`, href: "research/rss.xml" }]}
>
  <Header />
  <Main pageTitle={RESEARCH.title} pageDesc={description}>
    <div class="space-y-3">
      <p>
        There are some topics where the state of the art changes frequently and
        I would like to get an update every few months. I set an agent to
        research a base version, then have an AI assistant that kicks off every
        one to three months, depending on topic, and looks up what's new. It
        opens a PR with a summary of the changes, and I can check the diff.
      </p>
      <p>
        I figured I might as well publish them. If you are interested in any of
        these topics, you can look them up here. You can also subscribe, to
        everything or to individual topics, and get an email when there is an
        update. That way we don't all have to burn tokens to find out the same
        things.
      </p>
      <p>
        There is also an
        <a
          href={`${RESEARCH.path}/rss.xml`}
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          >RSS feed</a
        > with every new version if that floats your boat.
      </p>
    </div>
    <div class="mt-6">
      <ResearchSignup scope="all" />
    </div>
    <ul class="mt-6">
      {articles.map(({ meta, hasCurrent }) => <ResearchCard {meta} {hasCurrent} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
