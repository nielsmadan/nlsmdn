---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { SERIES } from "@/series";
import { getSeriesLabel } from "@/utils/seriesLabel";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
const seriesLabel = getSeriesLabel(data);
const seriesTitle = data.series && SERIES[data.series].title;
---

<li class="my-4">
  {
    seriesLabel && (
      <a
        href={`/series/${data.series}/`}
        aria-label={`All posts in ${seriesTitle}`}
        class="mb-0.5 block w-fit font-heading text-xs uppercase tracking-widest text-foreground/60 decoration-dashed underline-offset-4 hover:text-accent hover:underline"
      >
        {seriesLabel}
      </a>
    )
  }
  <a
    href={getPath(id, filePath)}
    class:list={[
      "inline-block font-heading text-lg font-medium text-accent sm:text-xl",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <Datetime {...props} showIcon={false} size="xs" />
  <p class="mt-1">{description}</p>
</li>
