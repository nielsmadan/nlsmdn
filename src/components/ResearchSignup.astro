---
import ResearchSubscribeForm from "@/components/ResearchSubscribeForm";
import { RESEARCH } from "@/research.config";

type Props = {
  scope: string;
};

const { scope } = Astro.props;
---

<div id="research-signup" data-scope={scope} data-pagefind-ignore>
  <ResearchSubscribeForm
    client:idle
    scope={scope}
    siteKey={RESEARCH.turnstileSiteKey}
  />
</div>
